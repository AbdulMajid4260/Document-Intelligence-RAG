# Copy this file to ".env" (same folder as package.json) to change settings.
#
# SECURITY: every variable that starts with VITE_ is bundled into the browser
# code and can be read by anyone who opens the site. NEVER put API keys,
# passwords, or other secrets in a VITE_ variable.

# Where the FastAPI backend will run during local development.
VITE_API_BASE_URL=http://127.0.0.1:8000

# "mock" = no backend needed, all data is simulated (default).
# "real" = send requests to VITE_API_BASE_URL.
VITE_API_MODE=mock
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_MODE=real