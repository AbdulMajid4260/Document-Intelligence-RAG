# Copy this file to ".env" and fill in your values:   Copy-Item .env.example .env
# NEVER commit ".env" or share your real API key.

# --- Groq LLM ------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60

# --- Storage -------------------------------------------------------------
# Relative paths are resolved against the Backend folder.
DATABASE_URL=sqlite:///./data/rag.db
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=10

# --- Chunking & retrieval defaults ---------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
MAX_CONTEXT_CHARS=12000

# --- Embeddings & vector store -------------------------------------------
# EMBEDDING_BACKEND: auto | sentence-transformers | hashing
#   auto                  = use sentence-transformers if installed, else LEXICAL hashing fallback (not semantic)
#   sentence-transformers = require semantic embeddings (fails clearly if they cannot load)
#   hashing               = always use the lexical fallback
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# VECTOR_STORE: numpy (always works) | chroma | faiss   (chroma/faiss need requirements-optional.txt)
VECTOR_STORE=numpy

# --- Web -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# JSON key style of responses: snake (default) | camel | both
RESPONSE_KEY_STYLE=snake
